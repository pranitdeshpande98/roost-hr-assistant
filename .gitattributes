# Store all text files with LF line endings in the repo, regardless of OS
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.parquet binary
*.sqlite binary
*.db binary