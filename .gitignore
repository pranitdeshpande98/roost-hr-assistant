coverage.xml
htmlcov/

# ── Secrets: never commit ──────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Data: generated or large files ─────
data/processed/*
!data/processed/.gitkeep
*.sqlite
*.db

# ── ML / model caches ──────────────────
.cache/
/models/

# ── Eval & run outputs ─────────────────

logs/

# ── Editors & OS ───────────────────────
.vscode/
.idea/
.cursor/
Thumbs.db
Desktop.ini
.DS_Store
