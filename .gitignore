# ── Python ─────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ── Virtual environments ───────────────
.venv/
venv/

# ── Tooling caches ─────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
