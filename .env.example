# Copy to .env and fill in values. .env is git-ignored — never commit it.

# ── Local Postgres (Docker) ─────────────────────────
POSTGRES_USER=roost
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=roost
POSTGRES_HOST_PORT=5432

# ── Application ─────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO

# ── App database connection ─────────────────────────
# Locally, the app builds its URL from the POSTGRES_* values above.
POSTGRES_HOST=127.0.0.1
# For hosted Postgres, set one full URL instead (it overrides POSTGRES_*):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require

# LLM providers (OpenAI-compatible). Real keys go in .env only.
GROQ_API_KEY=
OPENROUTER_API_KEY=
